# ---------------------------------------------------------------------------
# Practo (Healthcare) Domain Support Agent - example environment file
#
# Copy to `.env` and adjust. This template contains NO secrets and NO API keys.
# The graded configuration below needs zero API keys and zero paid accounts.
#
#   cp .env.example .env          (macOS / Linux)
#   Copy-Item .env.example .env   (Windows PowerShell)
# ---------------------------------------------------------------------------


# --- Application ----------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO


# --- Language-model mode --------------------------------------------------
# MOCK_LLM=true is the GRADED mode: deterministic, keyless, no network.
# Every acceptance criterion in the brief is satisfied with MOCK_LLM=true.
MOCK_LLM=true


# --- Offline / network posture -------------------------------------------
# OFFLINE_MODE=true exports HF_HUB_OFFLINE / TRANSFORMERS_OFFLINE before the
# embedding model is loaded, so SentenceTransformers can never silently reach
# out to the network. ALLOW_MODEL_DOWNLOAD=true is the ONLY way to permit a
# first-time model download (do this once, on a machine that allows it).
OFFLINE_MODE=true
ALLOW_MODEL_DOWNLOAD=false


# --- Embeddings -----------------------------------------------------------
# EMBEDDING_BACKEND options:
#   sentence_transformers  (DEFAULT, graded path) - free local SentenceTransformers
#   chroma_onnx            - ChromaDB's own bundled ONNX all-MiniLM-L6-v2 build;
#                            same model, onnxruntime instead of torch. Use when
#                            torch cannot be installed. Documented, not default.
#   deterministic_hash     - hashing pseudo-embedder for the offline test suite
#                            ONLY. Retrieval quality is NOT meaningful. Never
#                            use for graded numbers.
EMBEDDING_BACKEND=sentence_transformers


# Absolute or repo-relative path to a pre-downloaded model directory. When set,
# this wins over EMBEDDING_MODEL_NAME and never touches the network.
EMBEDDING_MODEL_PATH=
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2


# --- Vector store ---------------------------------------------------------
CHROMA_PERSIST_DIRECTORY=./data/generated/chroma
FIXED_COLLECTION_NAME=practo_kb_fixed
SENTENCE_COLLECTION_NAME=practo_kb_sentence
# Which collection the CrewAI Retrieval Agent uses. Set this to whatever
# scripts/compare_chunking.py recommends after you run it locally.
RECOMMENDED_COLLECTION_NAME=practo_kb_sentence


# --- Chunking parameters --------------------------------------------------
FIXED_CHUNK_SIZE=480
FIXED_CHUNK_OVERLAP=96
SENTENCES_PER_CHUNK=2


# --- Retrieval ------------------------------------------------------------
TOP_K=3
# SIMILARITY_THRESHOLD is intentionally EMPTY. It must be measured, not
# guessed: run `python -m scripts.calibrate_threshold`, which writes
# data/generated/calibration.json. Setting this variable pins a previously
# measured value (useful for reproducing a graded run on a fresh checkout).
SIMILARITY_THRESHOLD=
# Minimum content-word overlap for a drafted sentence to count as grounded.
GROUNDEDNESS_OVERLAP_MIN=0.6


# --- CrewAI ---------------------------------------------------------------
# CREW_MODE options:
#   crewai (DEFAULT, graded path) - real crew.kickoff() orchestration
#   direct                        - diagnostic straight-line pipeline that
#                                   reuses the identical tools + composition
#                                   code. Useful when CrewAI cannot be
#                                   installed. NOT the graded path.
CREW_MODE=crewai
CREW_MAX_ITER=4


# CrewAI ships telemetry that attempts an outbound call on kickoff(). Both of
# these must be set BEFORE crewai is imported; app/config.py exports them.
CREWAI_DISABLE_TELEMETRY=true
OTEL_SDK_DISABLED=true
CREWAI_DISABLE_VERSION_CHECK=true


# --- Autogen review stage -------------------------------------------------
REVIEW_ENABLED=true


# --- Runtime governance: per-request budget cap ---------------------------
MAX_REQUEST_CHARACTERS=2000
MAX_ESTIMATED_TOKENS=600


# --- Caching --------------------------------------------------------------
CACHE_ENABLED=true
CACHE_MAX_ENTRIES=512


# --- Observability --------------------------------------------------------
LOG_FILE=./data/generated/requests.jsonl


# --- Optional real-LLM extension point (disabled by default) --------------
# Nothing in the graded path reads these. Left blank on purpose; never commit
# a real key to this repository.
REAL_LLM_PROVIDER=
REAL_LLM_MODEL=
REAL_LLM_API_KEY=